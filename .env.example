# =============================================================================
# Surya AI — Environment Variables
# =============================================================================
# Copy this file to `.env.local` (dev) or set on Vercel dashboard (prod).
# Never commit real values. Lines marked OPTIONAL have sensible defaults.

# -----------------------------------------------------------------------------
# Public app config
# -----------------------------------------------------------------------------

# Canonical site URL (NO trailing slash). MUST match what users hit in browser.
# Vercel: set via dashboard. Apex domain (suryaai.in) 308s to www, so the
# canonical URL must include www.
NEXTAUTH_URL=https://www.suryaai.in
NEXT_PUBLIC_APP_URL=https://www.suryaai.in
NEXT_PUBLIC_APP_NAME=Surya AI

# -----------------------------------------------------------------------------
# NextAuth (OAuth login)
# -----------------------------------------------------------------------------

# Random 64-char string. Generate: openssl rand -hex 32
NEXTAUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/auth/clients
# Authorized redirect URIs must include:
#   https://<your-domain>/api/auth/callback/google
#   https://<your-domain>/api/connectors/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
# Callback URL: https://<your-domain>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Token encryption (OAuth tokens stored in DB)
# -----------------------------------------------------------------------------

# 64-char hex (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# InsForge (database + AI gateway)
# -----------------------------------------------------------------------------

INSFORGE_BASE_URL=
INSFORGE_API_KEY=
INSFORGE_ANON_KEY=

# Storage bucket name (OPTIONAL, default: media-assets)
MEDIA_BUCKET=media-assets

# -----------------------------------------------------------------------------
# AI model routing (via InsForge gateway)
# -----------------------------------------------------------------------------

DEFAULT_MODEL=gemini-3-1-pro
MEDIUM_MODEL=claude-sonnet-4-6
LARGE_MODEL=claude-opus-4-6
WEB_SEARCH_MODEL=gemini-3-1-pro
IMAGE_GEN_MODEL=gemini-3-pro-image

# Image gen — duplicates of INSFORGE_* (legacy, can reuse same values)
IMAGE_GEN_API_URL=
IMAGE_GEN_API_KEY=
IMAGE_GEN_ANON_KEY=

# Web search via gateway — duplicates of INSFORGE_* (same values)
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=
WEB_SEARCH_ANON_KEY=

# -----------------------------------------------------------------------------
# Kimi K2.5 model id — for Web Search, Deep Research, Slides/Sheets/Docs gen
# Routed through InsForge gateway (no separate API key needed).
# -----------------------------------------------------------------------------
KIMI_MODEL=moonshotai/kimi-k2.5

# -----------------------------------------------------------------------------
# Web search fallback (OPTIONAL, recommended)
# -----------------------------------------------------------------------------

# Brave Search API. Free tier: https://brave.com/search/api
# Without this, search falls back to DuckDuckGo HTML scraping (slow + brittle).
BRAVE_SEARCH_API_KEY=

# -----------------------------------------------------------------------------
# Media generation (TTS, video, avatar)
# -----------------------------------------------------------------------------

# ElevenLabs (TTS) — https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Sarvam (Indian-language TTS) — https://sarvam.ai
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v2

# Fal.ai (video gen) — https://fal.ai
FAL_KEY=
FAL_MODEL_T2V=fal-ai/ltx-2
FAL_MODEL_I2V=fal-ai/ltx-2-19b/image-to-video
FAL_MODEL_V2V=fal-ai/ltx-2

# Replicate (avatar / LivePortrait) — OPTIONAL
REPLICATE_API_TOKEN=
REPLICATE_LIVEPORTRAIT_VERSION=
REPLICATE_LTX_VERSION=

# Google AI (Veo video) — OPTIONAL
GOOGLE_AI_API_KEY=
VEO_MODEL=veo-3.0-generate-001

# Hugging Face (priority queue / Spaces fallback) — OPTIONAL
HF_TOKEN=
HF_VIDEO_SPACE=multimodalart/wan2-1-fast

# -----------------------------------------------------------------------------
# Rate limiting (OPTIONAL — Upstash Redis. Without it, in-memory limits used.)
# -----------------------------------------------------------------------------

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Auto-injected by Vercel (do NOT set manually)
# -----------------------------------------------------------------------------
# VERCEL_URL                       — current deployment URL
# VERCEL_PROJECT_PRODUCTION_URL    — canonical production URL
# NODE_ENV                         — production/development/test
